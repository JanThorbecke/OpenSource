#!/bin/bash
#PBS -N fdelmod
#PBS -q verylong
#PBS -l nodes=1
#PBS -k eo
#PBS -j eo

which makewave
which makemod


cp=2000
rho=1000
dx=2.5
dt=0.0004

makemod sizex=5000 sizez=2000 dx=$dx dz=$dx cp0=$cp ro0=$rho \
	orig=0,0 file_base=model.su \
	intt=def x=0,5000 z=1000,1000 poly=0 cp=3500 ro=5000 

#	intt=def x=-2500,0,2500 z=500,500,500 poly=0 cp=2300 ro=5000 

makewave fp=20 dt=$dt file_out=wave.su nt=4096 t0=0.1

fdelmodc \
    file_cp=model_cp.su ischeme=1 \
    file_den=model_ro.su \
    file_src=wave.su \
    file_rcv=shot_x1150.su \
    src_type=1 \
	src_orient=1 \
	src_injectionrate=1 \
    rec_type_vz=0 \
    rec_type_p=1 \
    rec_int_vz=2 \
    dtrcv=0.0012 \
	rec_delay=0.1 \
    verbose=2 \
    tmod=1.60 \
    dxrcv=5.0 \
    xrcv1=0 xrcv2=5000 \
    zrcv1=0 zrcv2=0 \
    xsrc=1000 zsrc=500 \
    sna_type_p=1 \
    sna_type_vz=1 \
    xsnap1=0 xsnap2=5000 zsnap1=500 zsnap2=2000 \
    tsnap1=0.1 tsnap2=1.6 dtsnap=0.008 \
    left=2 right=2 top=2 bottom=2 npml=40

exit
